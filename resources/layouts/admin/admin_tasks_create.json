{
    "version": "1.0.0",
    "layout_name": "admin_tasks_create",
    "permissions": [
        "glitter-tasks.tasks.read",
        "glitter-tasks.tasks.create"
    ],
    "extends": "_admin_base",
    "meta": {
        "title": "$t:glitter-tasks.admin.tasks.create.page_title",
        "description": "$t:glitter-tasks.admin.tasks.create.page_description"
    },
    "init_actions": [
        {
            "handler": "setState",
            "params": {
                "target": "local",
                "form": {
                    "title": "",
                    "description": "",
                    "due_at": ""
                },
                "saving": false,
                "errors": null
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "task_create_content",
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "admin-page-content-responsive-fluid"
                },
                "children": [
                    {
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:glitter-tasks.admin.tasks.create.title",
                            "description": "$t:glitter-tasks.admin.tasks.create.description",
                            "backLink": "/admin/tasks",
                            "backLinkText": "$t:glitter-tasks.admin.tasks.detail.back_to_list"
                        }
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_local.errors && Object.keys(_local.errors).length > 0}}",
                        "props": {
                            "className": "alert-danger mb-6"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "P",
                                "text": "{{_local.errors?.title?.[0] ?? _local.errors?.description?.[0] ?? _local.errors?.due_at?.[0] ?? _local.errors?.message ?? '$t:glitter-tasks.admin.tasks.errors.validation_failed'}}"
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "admin-card"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "space-y-5"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label-muted"
                                                },
                                                "text": "$t:glitter-tasks.admin.tasks.fields.title"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "text",
                                                    "value": "{{_local.form?.title ?? ''}}",
                                                    "placeholder": "$t:glitter-tasks.admin.tasks.create.title_placeholder",
                                                    "required": true,
                                                    "className": "w-full"
                                                },
                                                "actions": [
                                                    {
                                                        "type": "change",
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "form.title": "{{$event.target.value}}"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label-muted"
                                                },
                                                "text": "$t:glitter-tasks.admin.tasks.fields.description"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Textarea",
                                                "props": {
                                                    "value": "{{_local.form?.description ?? ''}}",
                                                    "placeholder": "$t:glitter-tasks.admin.tasks.create.description_placeholder",
                                                    "rows": 5,
                                                    "className": "w-full"
                                                },
                                                "actions": [
                                                    {
                                                        "type": "change",
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "form.description": "{{$event.target.value}}"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label-muted"
                                                },
                                                "text": "$t:glitter-tasks.admin.tasks.fields.due_at"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "text",
                                                    "value": "{{_local.form?.due_at ?? ''}}",
                                                    "placeholder": "$t:glitter-tasks.admin.tasks.create.due_at_placeholder",
                                                    "className": "w-full"
                                                },
                                                "actions": [
                                                    {
                                                        "type": "change",
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "form.due_at": "{{$event.target.value}}"
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-label-subtle text-sm mt-1"
                                                },
                                                "text": "$t:glitter-tasks.admin.tasks.create.due_at_help"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "sticky-footer-buttons"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "className": "btn btn-secondary"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/tasks",
                                            "mergeQuery": true,
                                            "query": {}
                                        }
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.cancel"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "className": "btn btn-primary",
                                    "disabled": "{{_local.saving}}"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "sequence",
                                        "params": {
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "saving": true,
                                                        "errors": null
                                                    }
                                                },
                                                {
                                                    "handler": "apiCall",
                                                    "auth_required": true,
                                                    "target": "/api/modules/glitter-tasks/admin/tasks",
                                                    "params": {
                                                        "method": "POST",
                                                        "body": {
                                                            "title": "{{_local.form?.title}}",
                                                            "description": "{{_local.form?.description?.trim() || null}}",
                                                            "due_at": "{{_local.form?.due_at?.trim() || null}}"
                                                        }
                                                    },
                                                    "onSuccess": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "saving": false
                                                            }
                                                        },
                                                        {
                                                            "handler": "toast",
                                                            "params": {
                                                                "type": "success",
                                                                "message": "$t:glitter-tasks.admin.tasks.messages.create_success"
                                                            }
                                                        },
                                                        {
                                                            "handler": "navigate",
                                                            "params": {
                                                                "path": "/admin/tasks/{{response.data.id}}",
                                                                "mergeQuery": true,
                                                                "query": {}
                                                            }
                                                        }
                                                    ],
                                                    "onError": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "saving": false,
                                                                "errors": "{{error.errors ?? {message: error.message}}}"
                                                            }
                                                        },
                                                        {
                                                            "handler": "toast",
                                                            "params": {
                                                                "type": "error",
                                                                "message": "{{error.message ?? '$t:glitter-tasks.admin.tasks.errors.generic'}}"
                                                            }
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "if": "{{_local.saving}}",
                                        "props": {
                                            "name": "spinner",
                                            "className": "spinner-sm"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "{{_local.saving ? '$t:common.saving' : '$t:common.save'}}"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
